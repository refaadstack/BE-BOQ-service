# Server Configuration
PORT=3005
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=boq_service
DB_USER=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=supersecretjwtkey
JWT_EXPIRES_IN=24h

# External Services
AUTH_SERVICE_URL=http://localhost:5000
PROJECT_SERVICE_URL=http://localhost:3004
ITEM_SERVICE_URL=http://localhost:3003
VENDOR_SERVICE_URL=http://localhost:3002

# File Upload Configuration
UPLOAD_DIR=./uploads
